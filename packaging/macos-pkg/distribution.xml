<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild distribution for the macOS .pkg. The release workflow
     replaces {{VERSION}}. -->
<installer-gui-script minSpecVersion="2">
    <title>Free Mind</title>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64" />
    <domains enable_localSystem="true" />
    <choices-outline>
        <line choice="tech.tanay.free-mind" />
    </choices-outline>
    <choice id="tech.tanay.free-mind" visible="false">
        <pkg-ref id="tech.tanay.free-mind" />
    </choice>
    <pkg-ref id="tech.tanay.free-mind" version="{{VERSION}}" onConclusion="none">free-mind-component.pkg</pkg-ref>
</installer-gui-script>

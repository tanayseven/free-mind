# Maintainer: Tanay PrabhuDesai <tanayseven at users dot noreply dot github dot com>
#
# AUR package repackaging the release .deb. The release workflow fills in
# {{VERSION}} and the checksums and attaches this file with its .SRCINFO.
pkgname=free-mind-bin
pkgver={{VERSION}}
pkgrel=1
pkgdesc="Block distracting websites and stay focused"
arch=('x86_64' 'aarch64')
url="https://github.com/tanayseven/free-mind"
license=('LicenseRef-unknown')
# polkit provides pkexec, which the one-time daemon install uses.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'polkit')
provides=('free-mind')
conflicts=('free-mind')
options=('!strip' '!debug')
_release="$url/releases/download/v$pkgver"
source_x86_64=("free-mind-$pkgver-x86_64.deb::$_release/Free.Mind_${pkgver}_amd64.deb")
source_aarch64=("free-mind-$pkgver-aarch64.deb::$_release/Free.Mind_${pkgver}_arm64.deb")
sha256sums_x86_64=('{{SHA256_DEB_AMD64}}')
sha256sums_aarch64=('{{SHA256_DEB_ARM64}}')

package() {
	bsdtar -xf data.tar.* -C "$pkgdir"
}

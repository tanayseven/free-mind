# Maintainer: Tanay PrabhuDesai <tanayseven at users dot noreply dot github dot com>
#
# AUR package built from the tagged source. The release workflow fills in
# {{VERSION}} and the checksum and attaches this file with its .SRCINFO.
pkgname=free-mind
pkgver={{VERSION}}
pkgrel=1
pkgdesc="Block distracting websites and stay focused"
arch=('x86_64' 'aarch64')
url="https://github.com/tanayseven/free-mind"
license=('LicenseRef-unknown')
# polkit provides pkexec, which the one-time daemon install uses.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'polkit')
makedepends=('cargo' 'npm')
conflicts=('free-mind-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('{{SHA256_SOURCE}}')

prepare() {
	cd "$pkgname-$pkgver"
	npm --prefix frontend ci
	cargo fetch --locked --manifest-path src-tauri/Cargo.toml --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	npm --prefix frontend run build
	cargo build --release --frozen \
		--manifest-path src-tauri/Cargo.toml \
		--features tauri/custom-protocol
}

package() {
	cd "$pkgname-$pkgver"
	sh packaging/install-tree.sh src-tauri/target/release/free-mind "$pkgdir" /usr
}
